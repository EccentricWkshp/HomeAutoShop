# HomeAutoShop configuration. Copy to .env and edit.
# Every value here has a working default; nothing is required to boot.
#
# ---------------------------------------------------------------------------
# Most of this file is now a *starting point*, not the place to change things.
#
# The shop name, the units, Offline Mode, the integration addresses
# and keys, the reminder settings and the backup schedule are all edited in the
# application, under Settings — and a value stored there wins over the one
# here. That is deliberate: renaming the shop should not require a text editor
# and a container restart, and the Offline Mode kill switch is an *emergency*
# control that has to be reachable by the person holding the emergency.
#
# What stays here is what cannot live in the database: values read before the
# database is reachable, and values a wrong answer would lock you out of the
# settings screen with. They are marked (environment only) below.
# ---------------------------------------------------------------------------

# (environment only) Which published release to run. Blank means `latest`,
# which is the right default while the interfaces are still moving: an instance
# picks up fixes on the next `docker compose pull` without anybody editing a
# file. Set it to a version — 0.7.1 — to pin, and nothing changes underneath
# you until you change this line. That becomes the better trade around 1.0.
# Ignored entirely when building locally with docker-compose.build.yml, which
# tags what it builds `:local`.
HOMEAUTOSHOP_TAG=

# (environment only) Signs sessions and cookies.
SECRET_KEY=change-me-to-something-random
# (environment only) Encrypts integration keys stored in the database. A key
# kept in the database it protects is not a key. Leave it blank and it is
# derived from SECRET_KEY, which works and is weaker — one secret protecting
# two things. Changing it invalidates every stored credential at once, which is
# the intended emergency behaviour.
CREDENTIAL_KEY=
# Static files are served by WhiteNoise either way; DEBUG only controls
# tracebacks and whether filenames carry a content hash. Keep it false on
# anything reachable from the network.
DEBUG=false
# Editable under Settings → Shop. The value there wins over this one.
SHOP_NAME=Home Shop

# Must be https:// for the camera, service worker and PWA install to work.
# If you change HTTPS_PORT below, put the port here too: this is the value QR
# labels are printed from, and a label is stuck to a bin long after anyone
# remembers editing this file.
BASE_URL=https://shop.home.arpa
SITE_ADDRESS=shop.home.arpa
ALLOWED_HOSTS=shop.home.arpa,localhost

# Which ports the host publishes. Change these if something on this machine is
# already using 80 or 443 — a NAS web interface, another reverse proxy, IIS —
# which is what `address already in use` means when the proxy will not start.
#
# Only the host side moves. Caddy still listens on 80 and 443 inside the
# container, so there is no Caddy configuration to change and no new
# certificate: the site is simply at https://your-host:8443 instead. The proxy
# says at startup if HTTPS_PORT and BASE_URL disagree about which.
HTTP_PORT=80
HTTPS_PORT=443

# How the certificate is obtained.
#
#   acme-dns  Let's Encrypt via a DNS-01 challenge. Recommended: every device
#             trusts it already, so there is nothing to install anywhere. Needs
#             a public domain name whose DNS has an API — including a free one
#             from a dynamic-DNS service, if you do not own a domain.
#   internal  Caddy signs it. Works with no prerequisites at all, but its root
#             certificate has to be installed on every phone, tablet and laptop
#             that will open the site, and reinstalled when they are replaced.
#   custom    you supply fullchain.pem and privkey.pem in config/caddy/certs.
#
# Let's Encrypt cannot issue for .home.arpa, .local or any other special-use
# name — no public CA can. Using acme-dns means SITE_ADDRESS is a real domain.
# It does not have to resolve publicly: keep the A record in local DNS only and
# the machine's address stays private.
TLS_MODE=internal

# Only read when TLS_MODE=acme-dns.
ACME_EMAIL=

# The Caddy module name, without the github.com/caddy-dns/ prefix — for example
# cloudflare, duckdns, desec, or acmedns. Four are compiled in; for anything
# else see Dockerfile.caddy, which takes the module as a build argument.
ACME_DNS_PROVIDER=

# For token-style providers (cloudflare, duckdns, desec) this is the API token,
# scoped to one zone wherever the provider allows it — it grants power over your
# DNS, so give it the least you can. For acmedns it is instead the path to that
# provider's JSON config, which you put in config/caddy/dns and reference as
# /etc/caddy/dns/acmedns.json.
ACME_DNS_TOKEN=

# Point at staging while setting up — five identical certificates per week is
# the production limit, and a wrong token burns them fast. Staging certificates
# are untrusted on purpose; reaching that point proves the challenge works.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_DB=homeautoshop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me

# Where photos and documents are kept.
#
#   filesystem  under MEDIA_ROOT, which in Compose is the `media-data` volume,
#               beside the database dump it gets backed up with. The default,
#               and what a single machine wants.
#   s3          an object store you run or rent — media on a NAS, on rented
#               storage, or on a host that is not this one. Everything below
#               applies only to this, and none of it has a working default.
#
# Nothing is bundled for `s3`, and it is worth knowing what it does and does
# not buy. The one advantage is a presigned URL streaming a photo straight to
# the browser, and that is off by default: such a link works for anybody who
# copies it, so the application serves the bytes itself and reading a photo
# requires being signed in.
#
# It also costs you a backup. `manage.py backup` copies MEDIA_ROOT, so with
# `s3` your photos are in none of the backups this application takes — you back
# that store up yourself. `manage.py migrate_storage --to s3` carries across
# the files you already have.
STORAGE_DRIVER=filesystem

# Only read when STORAGE_DRIVER=s3.
# The address the *application* talks to. Blank means real AWS S3.
STORAGE_ENDPOINT=
STORAGE_BUCKET=homeautoshop
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# (environment only) The address a *browser* can reach the store at. Leave it
# blank unless you have genuinely published the store, with its own
# certificate. Blank means photos are served by the application — which works
# everywhere, needs no extra setup, and has the property that reading one
# requires being signed in. A presigned object-store URL does not: copied out
# of the address bar it works for anybody who has it, until it expires.
STORAGE_PUBLIC_ENDPOINT=

# Localization (SPEC §5.6). Ships en-US complete; en-CA, fr-CA, es-MX are
# translator-ready catalogues.
LOCALE_DEFAULT=en-us
CURRENCY_REPORTING=USD
UNITS=imperial
TZ=UTC

# Integrations. All outbound traffic stops when OFFLINE_MODE is true.
OFFLINE_MODE=false
VIN_DECODE_ENABLED=true
RECALLS_ENABLED=true
SERVICE_INFO_ENABLED=true
SERVICE_INFO_DEFAULT=lemon
OUTBOUND_ALLOWLIST=vpic.nhtsa.dot.gov,api.nhtsa.gov

# The shared template catalog: service schedules, inspection checklists and
# parser profiles other people have published (SPEC §8.1b). Defaults to this
# project's own catalog, so it works without being configured.
#
# A default address is not a default request: nothing is fetched until somebody
# presses Browse — never on start-up, never in the background. Point it at your
# club's fork if you would rather, or blank it to switch the feature off. The
# host joins the outbound allowlist automatically either way.
CATALOG_URL=https://raw.githubusercontent.com/EccentricWkshp/HomeAutoShop/main/catalog/

# Which Bluetooth adapters the code-reading page may offer (SPEC §8.3c). This
# is nothing to do with the server — it has no Bluetooth — it is handed to the
# browser, which is the thing standing next to the car.
#
# The default is the standard Serial Port Profile, which is what most adapters
# use, an OBDLink MX+ included. Leave it alone unless an adapter shows up on a
# desktop and not on a phone: that means it puts its serial service behind the
# maker's own identifier, and a phone withholds anything it was not told to
# expect. The page prints `Bluetooth service:` and the identifier when it
# connects on the desktop; add it here, comma-separated, and keep the standard
# one.
ELM327_BLUETOOTH_SERVICE_UUIDS=00001101-0000-1000-8000-00805f9b34fb

# LubeLogger. Optional and additive: an instance with this unset
# is not degraded. Its host is added to the outbound allowlist automatically,
# which is how a self-hosted instance on the LAN is reachable.
LUBELOGGER_URL=
LUBELOGGER_API_KEY=
# off | import_once | pull | pull_push_odometer
# `import_once` never polls. Only the two `pull` modes put the sync on a timer,
# and the one-time import is what captures nearly all the value.
LUBELOGGER_MODE=import_once
LUBELOGGER_SYNC_HOURS=12

# WrenchLedger — tool availability on a work order. With this unset
# HomeAutoShop is complete and correct, only less convenient. The key needs
# exactly four read scopes: workspace, tools, loans, maintenance. Not
# loans:sensitive — borrower contact details are never wanted here.
WRENCHLEDGER_API_KEY=
WRENCHLEDGER_SYNC_HOURS=6
# homeautoshop | split | wrenchledger — which system owns shop consumables, so
# a quart of oil is not counted in both (FR-WL-9).
CONSUMABLES_OWNER=homeautoshop

# Plate lookup. There is no free, legal plate-to-VIN service, so
# this needs a commercial provider and an account of your own. Nothing is
# bundled or recommended. Every call costs money and sends a plate off your
# network, which is why it is off and why the cap is worth setting.
# api.carsxe.com - has a free tier for vin and plate decoding.
# vehicleregistrationapi.com offers 10 free lookups upon registration.
PLATE_LOOKUP_ENABLED=false
PLATE_LOOKUP_PROVIDER=generic
PLATE_LOOKUP_URL=
PLATE_LOOKUP_KEY=
# 0 means no cap. A cap is the difference between a mistake costing a dollar
# and a mistake costing a month's budget.
PLATE_LOOKUP_MONTHLY_CAP=0
# Your own per-call estimate, in minor units. Shown before each lookup.
PLATE_LOOKUP_COST_MINOR=0

# Costs
COST_INCLUDE_TOOLING=false
LABOR_RATE_MINOR=0

# Reminders. Off by default; a channel must also be created
# and enabled before anything is delivered. Nothing sends when there is nothing
# to say — there is no "all clear" message.
REMINDERS_ENABLED=false
REMINDER_COOLDOWN_DAYS=7
SMTP_HOST=
SMTP_PORT=587 # 587 for TLS or 465 for SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=homeautoshop@localhost

STRIP_GPS_EXIF=true
MAX_UPLOAD_MB=50

# Text recognition. Runs in the worker, on this machine — the only
# alternative for a receipt is somebody else's server.
OCR_ENABLED=true
# Language packs, space-separated Tesseract codes. What this does depends on
# whether you pull or build.
#
# Pulling: it is only what the application *asks* for, and the published image
# installs English. Asking for more is not an error — OCR narrows to what is
# installed and logs once what it dropped, because Tesseract fails the whole
# call for one missing language rather than skipping it — but it does not
# conjure the pack. Editable afterwards under Settings → Media.
#
# Building (docker-compose.build.yml): it decides both halves from one
# variable, so the packs installed and the languages asked for cannot drift.
# `eng fra spa deu ita` are the ones most likely to be wanted; each adds a few
# megabytes to the image.
TESSERACT_LANGS=eng
# How far into an image-only PDF to read before giving up. A receipt is one
# page; a service manual is hundreds, and reading all of them helps nobody.
OCR_PDF_MAX_PAGES=20

# Backup. Editable under Settings → Backup, and the whole screen is
# there: take one now, see what is held, download it, build a portable export.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_WARN_AFTER_DAYS=7

# How long a job may hold its lock before the worker running it is presumed
# dead and the job is put back on the queue. Raise it if you have an export
# that legitimately runs longer than an hour; the cost of setting it too low
# is a second copy of a slow job, and of too high is that a backup orphaned by
# a redeploy waits that long before the next one can start.
JOB_STALE_AFTER_MINUTES=60
LOG_LEVEL=INFO
