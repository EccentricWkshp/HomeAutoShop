# HomeAutoShop configuration (SPEC §14). Copy to .env and edit.
# Every value here has a working default; nothing is required to boot.

SECRET_KEY=change-me-to-something-random
# Static files are served by WhiteNoise either way; DEBUG only controls
# tracebacks and whether filenames carry a content hash. Keep it false on
# anything reachable from the network.
DEBUG=false
SHOP_NAME=Home Shop

# Must be https:// for the camera, service worker and PWA install to work.
BASE_URL=https://shop.home.arpa
SITE_ADDRESS=shop.home.arpa
ALLOWED_HOSTS=shop.home.arpa,localhost
# How the certificate is obtained.
#
#   acme-dns  Let's Encrypt via a DNS-01 challenge. Recommended: every device
#             trusts it already, so there is nothing to install anywhere. Needs
#             a public domain name whose DNS has an API — including a free one
#             from a dynamic-DNS service, if you do not own a domain.
#   internal  Caddy signs it. Works with no prerequisites at all, but its root
#             certificate has to be installed on every phone, tablet and laptop
#             that will open the site, and reinstalled when they are replaced.
#   custom    you supply fullchain.pem and privkey.pem in config/caddy/certs.
#
# Let's Encrypt cannot issue for .home.arpa, .local or any other special-use
# name — no public CA can. Using acme-dns means SITE_ADDRESS is a real domain.
# It does not have to resolve publicly: keep the A record in local DNS only and
# the machine's address stays private.
TLS_MODE=internal

# Only read when TLS_MODE=acme-dns.
ACME_EMAIL=
# The Caddy module name, without the github.com/caddy-dns/ prefix — for example
# cloudflare, duckdns, desec, or acmedns. Four are compiled in; for anything
# else see Dockerfile.caddy, which takes the module as a build argument.
ACME_DNS_PROVIDER=
# For token-style providers (cloudflare, duckdns, desec) this is the API token,
# scoped to one zone wherever the provider allows it — it grants power over your
# DNS, so give it the least you can. For acmedns it is instead the path to that
# provider's JSON config, which you put in config/caddy/dns and reference as
# /etc/caddy/dns/acmedns.json.
ACME_DNS_TOKEN=
# Point at staging while setting up — five identical certificates per week is
# the production limit, and a wrong token burns them fast. Staging certificates
# are untrusted on purpose; reaching that point proves the challenge works.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_DB=homeautoshop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me

# `s3` expects the MinIO service from docker-compose.yml. Running outside
# Compose without it, set `filesystem` — uploads otherwise stall on DNS.
STORAGE_DRIVER=s3
STORAGE_BUCKET=homeautoshop
STORAGE_ACCESS_KEY=homeautoshop
STORAGE_SECRET_KEY=change-me

# Localization (SPEC §5.6). Ships en-US complete; en-CA, fr-CA, es-MX are
# translator-ready catalogues.
LOCALE_DEFAULT=en-us
CURRENCY_REPORTING=USD
UNITS=imperial
TZ=UTC

# Integrations. All outbound traffic stops when OFFLINE_MODE is true.
OFFLINE_MODE=false
VIN_DECODE_ENABLED=true
SERVICE_INFO_ENABLED=true
SERVICE_INFO_DEFAULT=lemon
OUTBOUND_ALLOWLIST=vpic.nhtsa.dot.gov,api.nhtsa.gov

# LubeLogger (SPEC §8.6). Optional and additive: an instance with this unset
# is not degraded. Its host is added to the outbound allowlist automatically,
# which is how a self-hosted instance on the LAN is reachable.
LUBELOGGER_URL=
LUBELOGGER_API_KEY=
# off | import_once | pull | pull_push_odometer
# `import_once` never polls. Only the two `pull` modes put the sync on a timer,
# and the one-time import is what captures nearly all the value.
LUBELOGGER_MODE=import_once
LUBELOGGER_SYNC_HOURS=12

# WrenchLedger (SPEC §8.7) — tool availability on a work order. With this unset
# HomeAutoShop is complete and correct, only less convenient. The key needs
# exactly four read scopes: workspace, tools, loans, maintenance. Not
# loans:sensitive — borrower contact details are never wanted here.
WRENCHLEDGER_API_KEY=
WRENCHLEDGER_SYNC_HOURS=6
# homeautoshop | split | wrenchledger — which system owns shop consumables, so
# a quart of oil is not counted in both (FR-WL-9).
CONSUMABLES_OWNER=homeautoshop

# Plate lookup (SPEC §8.2). There is no free, legal plate-to-VIN service, so
# this needs a commercial provider and an account of your own. Nothing is
# bundled or recommended. Every call costs money and sends a plate off your
# network, which is why it is off and why the cap is worth setting.
PLATE_LOOKUP_ENABLED=false
PLATE_LOOKUP_PROVIDER=generic
PLATE_LOOKUP_URL=
PLATE_LOOKUP_KEY=
# 0 means no cap. A cap is the difference between a mistake costing a dollar
# and a mistake costing a month's budget.
PLATE_LOOKUP_MONTHLY_CAP=0
# Your own per-call estimate, in minor units. Shown before each lookup.
PLATE_LOOKUP_COST_MINOR=0

# Costs
COST_INCLUDE_TOOLING=false
LABOR_RATE_MINOR=0

# Reminders (SPEC FR-MAINT-10). Off by default; a channel must also be created
# and enabled before anything is delivered. Nothing sends when there is nothing
# to say — there is no "all clear" message.
REMINDERS_ENABLED=false
REMINDER_COOLDOWN_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=homeautoshop@localhost

STRIP_GPS_EXIF=true
MAX_UPLOAD_MB=50
BACKUP_WARN_AFTER_DAYS=7
LOG_LEVEL=INFO
